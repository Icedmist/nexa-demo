# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SUPABASE_URL: The URL of your Supabase project.
SUPABASE_URL=""
# SUPABASE_PUBLISHABLE_KEY: The anon/public key of your Supabase project.
SUPABASE_PUBLISHABLE_KEY=""
# SUPABASE_SERVICE_ROLE_KEY: The service role key of your Supabase project (keep secret!).
SUPABASE_SERVICE_ROLE_KEY=""

# VITE_SUPABASE_URL: The URL of your Supabase project (exposed to client).
VITE_SUPABASE_URL=""
# VITE_SUPABASE_PUBLISHABLE_KEY: The anon/public key of your Supabase project (exposed to client).
VITE_SUPABASE_PUBLISHABLE_KEY=""

# VITE_STORE_DOMAIN: The production domain used for wildcard subdomains (defaults to nexastoreos.com)
VITE_STORE_DOMAIN="nexastoreos.com"

# GMAIL_ACCESS_TOKEN: A valid Google OAuth Access Token with permission to send emails (https://www.googleapis.com/auth/gmail.send scope)
GMAIL_ACCESS_TOKEN=""
# GMAIL_REFRESH_TOKEN: Optional Google OAuth Refresh Token for permanent automatic token renewal
GMAIL_REFRESH_TOKEN=""
# GMAIL_CLIENT_ID: Optional Google OAuth Client ID
GMAIL_CLIENT_ID=""
# GMAIL_CLIENT_SECRET: Optional Google OAuth Client Secret
GMAIL_CLIENT_SECRET=""
